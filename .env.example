# ==============================================================================
# WhiteCode Meet Automation Configuration (.env)
# ==============================================================================

# Google Calendar Webhook URL (Public HTTPS endpoint, e.g. ngrok or Cloudflare tunnel)
PUBLIC_WEBHOOK_URL=https://your-public-tunnel.trycloudflare.com

# Google Gemini API Key (Multilingual Marathi & English Speech Transcription & Tasksheet Extraction)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# WhiteCode Production Tasksheet REST API Integration
# ------------------------------------------------------------------------------
# Set to 'true' once you are ready to connect to your live WhiteCode Tasksheet portal
EXTERNAL_SYNC_ENABLED=false

# Base URL of your WhiteCode Tasksheet / HR REST API
EXTERNAL_TASKSHEET_API_BASE_URL=https://api.whitecodelabs.com

# API Key or Bearer Token for authenticating with your WhiteCode API
EXTERNAL_TASKSHEET_API_KEY=your_whitecode_api_key_here

# Optional: customize specific endpoints if different from defaults
EXTERNAL_EMPLOYEES_ENDPOINT=/api/employees
EXTERNAL_PROJECTS_ENDPOINT=/api/projects
EXTERNAL_TASKSHEET_ENDPOINT=/api/tasksheet/entries
